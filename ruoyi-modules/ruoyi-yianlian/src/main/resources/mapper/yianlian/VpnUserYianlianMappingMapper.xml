<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.yianlian.mapper.VpnUserYianlianMappingMapper">

    <resultMap type="com.ruoyi.yianlian.domain.VpnUserYianlianMapping" id="MappingResult">
        <id     property="id"                column="id"                 />
        <result property="vpnUserId"         column="vpn_user_id"        />
        <result property="yianlianUserId"    column="yianlian_user_id"   />
        <result property="yianlianUserName"  column="yianlian_user_name" />
        <result property="delFlag"           column="del_flag"           />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
    </resultMap>

    <sql id="selectColumns">
        select id, vpn_user_id, app_id, yianlian_user_id, yianlian_user_name, del_flag, create_by, create_time, update_by, update_time
        from vpn_user_yianlian_mapping
    </sql>

    <select id="selectVpnUserYianlianMappingById" parameterType="Long" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where id = #{id}
    </select>

    <select id="selectVpnUserYianlianMappingList" parameterType="com.ruoyi.yianlian.domain.VpnUserYianlianMapping" resultMap="MappingResult">
        <include refid="selectColumns"/>
        <where>
            <if test="vpnUserId != null">and vpn_user_id = #{vpnUserId}</if>
            <if test="yianlianUserId != null and yianlianUserId != ''">and yianlian_user_id = #{yianlianUserId}</if>
            <if test="yianlianUserName != null and yianlianUserName != ''">and yianlian_user_name like concat('%', #{yianlianUserName}, '%')</if>
            <if test="delFlag != null and delFlag != ''">and del_flag = #{delFlag}</if>
        </where>
    </select>

    <select id="selectByVpnUserId" parameterType="Long" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where vpn_user_id = #{vpnUserId} and del_flag = '0'
    </select>

    <select id="selectByYianlianUserId" parameterType="String" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where yianlian_user_id = #{yianlianUserId} and del_flag = '0'
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where vpn_user_id = #{userId}
    </select>

    <select id="selectByUserIdAndAppId" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where vpn_user_id = #{userId} and app_id = #{appId}
    </select>

    <insert id="insertVpnUserYianlianMapping" parameterType="com.ruoyi.yianlian.domain.VpnUserYianlianMapping" useGeneratedKeys="true" keyProperty="id">
        insert into vpn_user_yianlian_mapping (
            <if test="vpnUserId != null">vpn_user_id,</if>
            <if test="yianlianUserId != null and yianlianUserId != ''">yianlian_user_id,</if>
            <if test="yianlianUserName != null and yianlianUserName != ''">yianlian_user_name,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values (
            <if test="vpnUserId != null">#{vpnUserId},</if>
            <if test="yianlianUserId != null and yianlianUserId != ''">#{yianlianUserId},</if>
            <if test="yianlianUserName != null and yianlianUserName != ''">#{yianlianUserName},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <insert id="insert" parameterType="com.ruoyi.yianlian.domain.VpnUserYianlianMapping" useGeneratedKeys="true" keyProperty="id">
        insert into vpn_user_yianlian_mapping (vpn_user_id, app_id, yianlian_user_id, yianlian_user_name, create_time)
        values (#{vpnUserId}, #{appId, jdbcType=VARCHAR}, #{yianlianUserId}, #{yianlianUserName}, sysdate())
    </insert>

    <update id="updateVpnUserYianlianMapping" parameterType="com.ruoyi.yianlian.domain.VpnUserYianlianMapping">
        update vpn_user_yianlian_mapping
        <set>
            <if test="vpnUserId != null">vpn_user_id = #{vpnUserId},</if>
            <if test="yianlianUserId != null and yianlianUserId != ''">yianlian_user_id = #{yianlianUserId},</if>
            <if test="yianlianUserName != null and yianlianUserName != ''">yianlian_user_name = #{yianlianUserName},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteVpnUserYianlianMappingById" parameterType="Long">
        delete from vpn_user_yianlian_mapping where id = #{id}
    </delete>

    <delete id="deleteVpnUserYianlianMappingByIds">
        delete from vpn_user_yianlian_mapping where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="deleteByVpnUserId" parameterType="Long">
        update vpn_user_yianlian_mapping set del_flag = '2' where vpn_user_id = #{vpnUserId}
    </update>

    <delete id="deleteByUserId" parameterType="Long">
        delete from vpn_user_yianlian_mapping where vpn_user_id = #{userId}
    </delete>

    <delete id="deleteByUserIds">
        delete from vpn_user_yianlian_mapping where vpn_user_id in
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

</mapper>
