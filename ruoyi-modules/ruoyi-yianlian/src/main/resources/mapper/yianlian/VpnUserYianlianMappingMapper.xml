<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.yianlian.mapper.VpnUserYianlianMappingMapper">

    <resultMap type="com.ruoyi.yianlian.domain.VpnUserYianlianMapping" id="MappingResult">
        <id     property="id"           column="id"           />
        <result property="userId"       column="user_id"      />
        <result property="appId"        column="app_id"       />
        <result property="yianlianId"   column="yianlian_id"  />
        <result property="createTime"   column="create_time"  />
    </resultMap>

    <sql id="selectColumns">
        select id, user_id, app_id, yianlian_id, create_time
        from vpn_user_yianlian_mapping
    </sql>

    <select id="selectByUserId" parameterType="Long" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where user_id = #{userId}
    </select>

    <select id="selectByUserIdAndAppId" resultMap="MappingResult">
        <include refid="selectColumns"/>
        where user_id = #{userId} and app_id = #{appId}
    </select>

    <insert id="insert" parameterType="com.ruoyi.yianlian.domain.VpnUserYianlianMapping" useGeneratedKeys="true" keyProperty="id">
        insert into vpn_user_yianlian_mapping (user_id, app_id, yianlian_id, create_time)
        values (#{userId}, #{appId}, #{yianlianId}, sysdate())
    </insert>

    <delete id="deleteByUserId" parameterType="Long">
        delete from vpn_user_yianlian_mapping where user_id = #{userId}
    </delete>

    <delete id="deleteByUserIds">
        delete from vpn_user_yianlian_mapping where user_id in
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

</mapper>
