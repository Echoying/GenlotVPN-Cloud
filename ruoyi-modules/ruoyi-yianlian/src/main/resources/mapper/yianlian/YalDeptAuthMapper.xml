<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.yianlian.mapper.YalDeptAuthMapper">

    <resultMap type="YalDeptAuth" id="YalDeptAuthResult">
        <result property="id"           column="id"            />
        <result property="deptId"       column="dept_id"       />
        <result property="lineId"       column="line_id"       />
        <result property="appGroupIds"  column="app_group_ids" />
        <result property="appIds"       column="app_ids"       />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="deptName"     column="dept_name"     />
    </resultMap>

    <sql id="selectYalDeptAuthVo">
        select id, dept_id, line_id, app_group_ids, app_ids, create_by, create_time, update_by, update_time from yal_dept_auth
    </sql>

    <select id="selectYalDeptAuthList" parameterType="YalDeptAuth" resultMap="YalDeptAuthResult">
        select a.id, a.dept_id, a.line_id, a.app_group_ids, a.app_ids, a.create_by, a.create_time, a.update_by, a.update_time, d.dept_name
        from yal_dept_auth a
        left join sys_dept d on a.dept_id = d.dept_id
        <where>
            <if test="deptId != null">
                and a.dept_id = #{deptId}
            </if>
            <if test="lineId != null and lineId != ''">
                and a.line_id = #{lineId}
            </if>
        </where>
    </select>

    <select id="selectYalDeptAuthById" parameterType="Long" resultMap="YalDeptAuthResult">
        <include refid="selectYalDeptAuthVo"/>
        where id = #{id}
    </select>

    <select id="selectYalDeptAuthByDeptId" parameterType="Long" resultMap="YalDeptAuthResult">
        <include refid="selectYalDeptAuthVo"/>
        where dept_id = #{deptId}
    </select>

    <insert id="insertYalDeptAuth" parameterType="YalDeptAuth" useGeneratedKeys="true" keyProperty="id">
        insert into yal_dept_auth
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">dept_id,</if>
            <if test="lineId != null and lineId != ''">line_id,</if>
            <if test="appGroupIds != null and appGroupIds != ''">app_group_ids,</if>
            <if test="appIds != null and appIds != ''">app_ids,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">#{deptId},</if>
            <if test="lineId != null and lineId != ''">#{lineId},</if>
            <if test="appGroupIds != null and appGroupIds != ''">#{appGroupIds},</if>
            <if test="appIds != null and appIds != ''">#{appIds},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <insert id="batchInsertYalDeptAuth">
        insert into yal_dept_auth(dept_id, line_id, app_group_ids, app_ids, create_by, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.deptId}, #{item.lineId}, #{item.appGroupIds}, #{item.appIds}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>

    <update id="updateYalDeptAuth" parameterType="YalDeptAuth">
        update yal_dept_auth
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="lineId != null and lineId != ''">line_id = #{lineId},</if>
            <if test="appGroupIds != null">app_group_ids = #{appGroupIds},</if>
            <if test="appIds != null">app_ids = #{appIds},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteYalDeptAuthById" parameterType="Long">
        delete from yal_dept_auth where id = #{id}
    </delete>

    <delete id="deleteYalDeptAuthByIds" parameterType="Long">
        delete from yal_dept_auth where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteYalDeptAuthByDeptId" parameterType="Long">
        delete from yal_dept_auth where dept_id = #{deptId}
    </delete>

</mapper>
