<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.yianlian.mapper.LineAppMapper">
    
    <resultMap type="LineApp" id="LineAppResult">
    	<id     property="appId"      column="app_id"      />
        <result property="appName"    column="app_name"    />
        <result property="appSecret"     column="app_secret"     />
        <result property="url"     column="url"     />
        <result property="proxyHost" column="proxy_host" />
        <result property="proxyPort" column="proxy_port" />
        <result property="proxyEnabled" column="proxy_enabled" />
        <result property="host"    column="host"    />
        <result property="srvPort" column="srv_port" />
        <result property="spaPort" column="spa_port" />
        <result property="spaKey"  column="spa_key"  />
        <result property="status"   column="status"   />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectLineAppVo">
        select app_id, app_name, app_secret, url, proxy_host, proxy_port, proxy_enabled, host, srv_port, spa_port, spa_key, status, create_by, create_time, update_by, update_time, remark
		from line_app
    </sql>
    
    <!-- 查询条件 -->
	<sql id="sqlwhereSearch">
		<where>
			<if test="appId !=null">
				and app_id = #{appId}
			</if>
            <if test="appName != null and appName != ''">
                AND app_name like concat('%', #{appName}, '%')
            </if>
		</where>
	</sql>
    
    <select id="selectLineApp" parameterType="LineApp" resultMap="LineAppResult">
        <include refid="selectLineAppVo"/>
        <include refid="sqlwhereSearch"/>
    </select>
    
    <select id="selectLineAppList" parameterType="LineApp" resultMap="LineAppResult">
        <include refid="selectLineAppVo"/>
        <where>
			<if test="appName != null and appName != ''">
				AND app_name like concat('%', #{appName}, '%')
			</if>
			<if test="appSecret != null and appSecret != ''">
				AND app_secret = #{appSecret}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
				and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
			</if>
			<if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
				and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
			</if>
		</where>
    </select>
    
    <select id="selectLineAppById" parameterType="String" resultMap="LineAppResult">
        <include refid="selectLineAppVo"/>
        where app_id = #{appId}
    </select>
    
    <insert id="insertLineApp" parameterType="LineApp">
        insert into line_app (
            <if test="appId != null and appId != '' ">app_id,</if>
			<if test="appName != null and appName != '' ">app_name,</if>
			<if test="appSecret != null and appSecret != '' ">app_secret,</if>
			<if test="url != null and url != '' ">url,</if>
			<if test="proxyHost != null and proxyHost != '' ">proxy_host,</if>
			<if test="proxyPort != null ">proxy_port,</if>
			<if test="proxyEnabled != null and proxyEnabled != '' ">proxy_enabled,</if>
			<if test="host != null and host != '' ">host,</if>
			<if test="srvPort != null ">srv_port,</if>
			<if test="spaPort != null ">spa_port,</if>
			<if test="spaKey != null and spaKey != '' ">spa_key,</if>
			<if test="status != null and status != '' ">status,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
 			create_time
        )values(
            <if test="appId != null and appId != ''">#{appId},</if>
			<if test="appName != null and appName != ''">#{appName},</if>
			<if test="appSecret != null and appSecret != ''">#{appSecret},</if>
			<if test="url != null and url != ''">#{url},</if>
			<if test="proxyHost != null and proxyHost != ''">#{proxyHost},</if>
			<if test="proxyPort != null">#{proxyPort},</if>
			<if test="proxyEnabled != null and proxyEnabled != ''">#{proxyEnabled},</if>
			<if test="host != null and host != ''">#{host},</if>
			<if test="srvPort != null">#{srvPort},</if>
			<if test="spaPort != null">#{spaPort},</if>
			<if test="spaKey != null and spaKey != ''">#{spaKey},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateLineApp" parameterType="LineApp">
        update line_app
        <set>
            <if test="appName != null and appName != ''">app_name = #{appName},</if>
            <if test="appSecret != null and appSecret != ''">app_secret = #{appSecret},</if>
            <if test="url != null and url != ''">url = #{url},</if>
            <if test="proxyHost != null">proxy_host = #{proxyHost},</if>
            <if test="proxyPort != null">proxy_port = #{proxyPort},</if>
            <if test="proxyEnabled != null and proxyEnabled != ''">proxy_enabled = #{proxyEnabled},</if>
            <if test="host != null and host != ''">host = #{host},</if>
            <if test="srvPort != null">srv_port = #{srvPort},</if>
            <if test="spaPort != null">spa_port = #{spaPort},</if>
            <if test="spaKey != null and spaKey != ''">spa_key = #{spaKey},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
 			update_time = sysdate()
        </set>
        where app_id = #{appId}
    </update>
	
    <delete id="deleteLineAppById" parameterType="String">
        delete from line_app where app_id = #{appId}
    </delete>
    
    <delete id="deleteLineAppByIds" parameterType="String">
        delete from line_app where app_id in
        <foreach item="appId" collection="array" open="(" separator="," close=")">
        	#{appId}
        </foreach>
    </delete>
    
</mapper>