<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.yianlian.mapper.VpnLocalUserMapper">

    <resultMap type="VpnLocalUser" id="VpnLocalUserResult">
        <id     property="localUserId"     column="local_user_id"    />
        <result property="userName"        column="user_name"        />
        <result property="nickName"        column="nick_name"        />
        <result property="email"           column="email"            />
        <result property="phonenumber"     column="phonenumber"      />
        <result property="sex"             column="sex"              />
        <result property="avatar"          column="avatar"           />
        <result property="password"        column="password"         />
        <result property="encryptedPwd"    column="encrypted_pwd"    />
        <result property="status"          column="status"           />
        <result property="delFlag"         column="del_flag"         />
        <result property="loginIp"         column="login_ip"         />
        <result property="loginDate"       column="login_date"       />
        <result property="pwdUpdateDate"   column="pwd_update_date"  />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
    </resultMap>

    <sql id="selectLocalUserVo">
        select local_user_id, user_name, nick_name, email, phonenumber, sex, avatar, password, encrypted_pwd,
               status, del_flag, login_ip, login_date, pwd_update_date, create_by, create_time, update_by, update_time, remark
        from vpn_local_user
    </sql>

    <select id="selectLocalUserList" parameterType="VpnLocalUser" resultMap="VpnLocalUserResult">
        <include refid="selectLocalUserVo"/>
        where del_flag = '0'
        <if test="userName != null and userName != ''">
            AND user_name like concat('%', #{userName}, '%')
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="phonenumber != null and phonenumber != ''">
            AND phonenumber like concat('%', #{phonenumber}, '%')
        </if>
        <if test="params.beginTime != null and params.beginTime != ''">
            AND date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
        </if>
        <if test="params.endTime != null and params.endTime != ''">
            AND date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
        </if>
    </select>

    <select id="selectLocalUserById" parameterType="Long" resultMap="VpnLocalUserResult">
        <include refid="selectLocalUserVo"/>
        where local_user_id = #{localUserId} and del_flag = '0'
    </select>

    <select id="selectLocalUserByUserName" parameterType="String" resultMap="VpnLocalUserResult">
        <include refid="selectLocalUserVo"/>
        where user_name = #{userName} and del_flag = '0'
    </select>

    <select id="checkUserNameUnique" parameterType="String" resultMap="VpnLocalUserResult">
        select local_user_id, user_name from vpn_local_user where user_name = #{userName} and del_flag = '0' limit 1
    </select>

    <insert id="insertLocalUser" parameterType="VpnLocalUser" useGeneratedKeys="true" keyProperty="localUserId">
        insert into vpn_local_user(
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="nickName != null and nickName != ''">nick_name,</if>
            <if test="email != null and email != ''">email,</if>
            <if test="avatar != null and avatar != ''">avatar,</if>
            <if test="phonenumber != null and phonenumber != ''">phonenumber,</if>
            <if test="sex != null and sex != ''">sex,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="encryptedPwd != null and encryptedPwd != ''">encrypted_pwd,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="nickName != null and nickName != ''">#{nickName},</if>
            <if test="email != null and email != ''">#{email},</if>
            <if test="avatar != null and avatar != ''">#{avatar},</if>
            <if test="phonenumber != null and phonenumber != ''">#{phonenumber},</if>
            <if test="sex != null and sex != ''">#{sex},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="encryptedPwd != null and encryptedPwd != ''">#{encryptedPwd},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateLocalUser" parameterType="VpnLocalUser">
        update vpn_local_user
        <set>
            <if test="nickName != null and nickName != ''">nick_name = #{nickName},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phonenumber != null">phonenumber = #{phonenumber},</if>
            <if test="sex != null and sex != ''">sex = #{sex},</if>
            <if test="avatar != null and avatar != ''">avatar = #{avatar},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where local_user_id = #{localUserId}
    </update>

    <update id="updateLocalUserLogin" parameterType="VpnLocalUser">
        update vpn_local_user
        <set>
            <if test="loginIp != null and loginIp != ''">login_ip = #{loginIp},</if>
            <if test="loginDate != null">login_date = #{loginDate},</if>
        </set>
        where local_user_id = #{localUserId}
    </update>

    <update id="resetLocalUserPwd" parameterType="VpnLocalUser">
        update vpn_local_user
        set password = #{password}, encrypted_pwd = #{encryptedPwd}, pwd_update_date = sysdate(), update_time = sysdate()
        where local_user_id = #{localUserId}
    </update>

    <delete id="deleteLocalUserByIds" parameterType="Long">
        update vpn_local_user set del_flag = '2' where local_user_id in
        <foreach collection="array" item="localUserId" open="(" separator="," close=")">
            #{localUserId}
        </foreach>
    </delete>

    <select id="selectUnsyncedByAppId" resultMap="VpnLocalUserResult">
        <include refid="selectLocalUserVo"/>
        where del_flag = '0' and status = '0'
          and not exists (
            select 1 from vpn_user u
            where u.local_user_id = vpn_local_user.local_user_id
              and u.app_id = #{appId} and u.del_flag = '0'
          )
        order by user_name
    </select>

</mapper>
