#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GENLOT_VERSION_MAJOR@,@GENLOT_VERSION_MINOR@,@GENLOT_VERSION_PATCH@,0
 PRODUCTVERSION @GENLOT_VERSION_MAJOR@,@GENLOT_VERSION_MINOR@,@GENLOT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Genlot"
            VALUE "FileDescription", "Genlot VPN Client"
            VALUE "FileVersion", "@GENLOT_VERSION_STRING@"
            VALUE "InternalName", "GenlotVPN"
            VALUE "LegalCopyright", "Copyright (C) Genlot"
            VALUE "OriginalFilename", "GenlotVPN-@GENLOT_VERSION_STRING@.exe"
            VALUE "ProductName", "Genlot VPN"
            VALUE "ProductVersion", "@GENLOT_VERSION_STRING@ (@GENLOT_BUILD_ID@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
